{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./.github/hooks/scripts/closeout-guard.ps1 session-start",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\.github\\hooks\\scripts\\closeout-guard.ps1 session-start",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./.github/hooks/scripts/closeout-guard.ps1 stop",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\.github\\hooks\\scripts\\closeout-guard.ps1 stop",
        "timeout": 15
      }
    ]
  }
}